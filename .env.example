# Local development database (SQLite)
DATABASE_URL="file:./dev.db"

# Production database (PostgreSQL) — use with `npm run db:use:postgres`
# DATABASE_URL="postgresql://atlas:atlas_password@localhost:5432/atlasclass?schema=public"

# Auth.js / NextAuth configuration
AUTH_SECRET="replace-with-a-32-byte-cryptographic-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Contact email
CONTACT_EMAIL="support@atlasclass.app"
